{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anjing Music X",
  "version": "0.2.3",
  "identifier": "cc.anjing.music-x",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anjing Music X",
        "width": 520,
        "height": 360,
        "minWidth": 420,
        "minHeight": 340,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#fbfaf6",
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMzgzRTcyMzE2MkI2RkEKUldUNnRtSXhjajQ0MzRqMjdTR3FqUUtKZ21ENVF1RS80WkFjaUNjK1hoeVYwN3FTd215MWEzcHUK",
      "endpoints": [
        "https://github.com/anjing-le/anjing-music-x/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
